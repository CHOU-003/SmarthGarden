        "func": "var value = msg.payload;\n\nvar now = new Date();\n\nvar dateVN = now.toLocaleDateString('vi-VN', {\n    timeZone: 'Asia/Ho_Chi_Minh'\n});\n\nvar timeVN = now.toLocaleTimeString('vi-VN', {\n    timeZone: 'Asia/Ho_Chi_Minh',\n    hour12: false,\n    hour: '2-digit',\n    minute: '2-digit'\n});\n\n// Ghép lại theo yêu cầu: ngày giờ, dữ liệu\nmsg.payload = `${dateVN} ${timeVN}, ${value}`;\n\nreturn msg;\n",
