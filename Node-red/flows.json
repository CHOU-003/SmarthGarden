    {
        "id": "ab09ecf934e9abc0",
        "type": "function",
        "z": "e90e4f047da94179",
        "name": "Extract temperature",
        "func": "// Đầu vào: chuỗi \"temp,hum,soil\"\nvar input = msg.payload;\n\n// Xử lý chuỗi\ninput = input.trim();\nvar values = input.split(',');\nvalues = values.map(function (value) {\n    return parseFloat(value.trim());\n});\n\n// Bắt lỗi nếu dữ liệu không hợp lệ\nif (values.length < 3 || isNaN(values[0])) {\n    node.error(\"Invalid input data: \" + input, msg);\n    return null;\n}\n\n// Lấy nhiệt độ (giá trị đầu tiên)\nmsg.payload = values[0]; // 0 là nhiệt độ\n\n// Bạn có thể gán thêm nhãn để tiện debug\nmsg.topic = \"current_temperature\";\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 320,
        "wires": [
            [
                "a10b3b3cda0f5bc6",
                "e1a366ffd3692b9c"
            ]
        ]
    },
    {
        "id": "b539c6886732500d",
        "type": "function",
        "z": "e90e4f047da94179",
        "name": "Extract humidity",
        "func": "var input = msg.payload; // Assuming the input is in msg.payload\n\n// Remove any leading or trailing whitespace\ninput = input.trim();\n\n// Split the input string using commas as the delimiter\nvar values = input.split(',');\n\n// Remove leading and trailing whitespace from each value and convert to float\nvalues = values.map(function (value) {\n    return parseFloat(value.trim());\n});\n\nmsg.payload = values[2]; // Set the output payload to the array of float values\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
